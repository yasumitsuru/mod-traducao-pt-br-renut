#!/bin/sh
# Recusa commits com dados sensíveis. Ative com: git config core.hooksPath .githooks
if command -v python >/dev/null 2>&1; then
    PY=python
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    echo "Python não encontrado: a verificação de privacidade não pode rodar." >&2
    exit 1
fi
"$PY" -I tools/verificar_privacidade.py --staged --publico || {
    echo "Commit recusado: corrija os problemas de privacidade acima." >&2
    exit 1
}