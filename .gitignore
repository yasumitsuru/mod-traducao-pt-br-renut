# Política de inclusão explícita: por padrão, nada entra no repositório.
# Só os caminhos liberados no fim deste arquivo podem ser rastreados.
*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE.md
!/AGENTS.md
!/pytest.ini
!/config/
!/config/caminhos.exemplo.toml
!/data/
!/data/**
!/docs/
!/docs/**
!/tests/
!/tests/**
!/tools/
!/tools/**
!/launcher-patch/
!/launcher-patch/**
!/.github/
!/.github/**
!/.githooks/
!/.githooks/**

# Dentro das pastas liberadas, estes padrões continuam proibidos.
data/strings/
app/
dist/
build/
target/
work/
**/__pycache__/
*.pyc
.pytest_cache/
.venv/
*.exe
*.dll
*.pdb
*.lib
*.obj
*.o
*.so
*.dylib
*.msi
*.bin
*.nbpatch
*.patch
*.zip
*.7z
*.rar
*.tar
*.gz
*.iso
*.xex
*.xexp
