# Política de inclusão explícita: por padrão, nada entra no repositório.
# Só os caminhos liberados no fim deste arquivo podem ser rastreados.
*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE.md
!/pytest.ini
!/config/
!/config/caminhos.exemplo.toml
!/data/
!/data/**
!/docs/
!/docs/**
!/tests/
!/tests/**
!/tools/
!/tools/**
!/.github/
!/.github/**
!/.githooks/
!/.githooks/**

# Dentro das pastas liberadas, estes padrões continuam proibidos.
data/strings/
**/__pycache__/
*.pyc
.pytest_cache/
.venv/
*.nbpatch
*.zip
*.iso
*.xex
*.xexp
*.sbp
*.dmp
*.log
*.tmp
*.key
*.pem
.env
.env.*
*token*
secrets/
renut.toml
renut.cfg
launcher.cfg
settings.local.json
user/
guide/
account.json
achievements.json
gamerpics/
crashdumps/
sentry/
logs/
Thumbs.db
Desktop.ini
