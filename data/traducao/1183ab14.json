{
  "arquivo": "1183ab14",
  "asset": "aid_loctext_banjox_vehicles",
  "frases": [
    {
      "id": "9121",
      "chave": "dialog__humba_balloon",
      "hash_es": "10a1dca73f9a916d",
      "texto_ptbr": "Legal como jato, mas também leve no combustível! Pechincha!",
      "lote": "614"
    },
    {
      "id": "f035",
      "chave": "dialog__humba_bike",
      "hash_es": "ffc02250da60469d",
      "texto_ptbr": "Duas rodas funcionar tão bem quanto quatro! Talvez.",
      "lote": "507"
    },
    {
      "id": "18b1",
      "chave": "dialog__humba_boat1",
      "hash_es": "ef83a2043cc69758",
      "texto_ptbr": "Urso pegar ondas em barco pequeno mas perfeitamente proporcionado.",
      "lote": "507"
    },
    {
      "id": "18b2",
      "chave": "dialog__humba_boat2",
      "hash_es": "48f36aad902912e9",
      "texto_ptbr": "Lancha pequena com hélice dupla, em esquema de cores de bom gosto.",
      "lote": "507"
    },
    {
      "id": "18b3",
      "chave": "dialog__humba_boat3",
      "hash_es": "4b8fe6af0949de13",
      "texto_ptbr": "Dois cascos e motor enorme, fazer bastante espuma!",
      "lote": "507"
    },
    {
      "id": "18b4",
      "chave": "dialog__humba_boat4",
      "hash_es": "6e34b05faf75201c",
      "texto_ptbr": "Jatos no barco? Bom em mar aberto, mas cuidado com as baleias!",
      "lote": "507"
    },
    {
      "id": "0a4e",
      "chave": "dialog__humba_boot",
      "hash_es": "77c1a6d5ddce114f",
      "texto_ptbr": "Urso estar com problema? Hora de pisar fundo!",
      "lote": "507"
    },
    {
      "id": "5a0a",
      "chave": "dialog__humba_cage",
      "hash_es": "1a7639551285af05",
      "texto_ptbr": "Jaula... sobre rodas. Muito boa se urso usar imaginação.",
      "lote": "507"
    },
    {
      "id": "600c",
      "chave": "dialog__humba_cargoboat",
      "hash_es": "b385a33a52985636",
      "texto_ptbr": "Transportar objetos pela água com facilidade, se a ideia agradar urso.",
      "lote": "507"
    },
    {
      "id": "2457",
      "chave": "dialog__humba_cargochopper",
      "hash_es": "ae2f12516665ecf5",
      "texto_ptbr": "Bola grudenta fazer este veículo ideal para pegar objetos de todo formato e tamanho.",
      "lote": "507"
    },
    {
      "id": "1316",
      "chave": "dialog__humba_cargoplane",
      "hash_es": "4281ad6da06f3c42",
      "texto_ptbr": "Maneira mais rápida de transportar itens. Dar um loop provavelmente não ser boa ideia.",
      "lote": "507"
    },
    {
      "id": "9062",
      "chave": "dialog__humba_carrier",
      "hash_es": "ba9c153376d27d02",
      "texto_ptbr": "Precisar mover o mundo? Sem problema com a maravilha logística da Humba!",
      "lote": "507"
    },
    {
      "id": "67b8",
      "chave": "dialog__humba_catapult",
      "hash_es": "25ed3fbafe5b0ed7",
      "texto_ptbr": "Veículo em forma de copo com molas. Para que serve, Humba deixar urso decidir.",
      "lote": "507"
    },
    {
      "id": "71dc",
      "chave": "dialog__humba_chopper1",
      "hash_es": "d49fc98552712abb",
      "texto_ptbr": "Urso ganhar os ares... mas cuidado para não ficar sem combustível.",
      "lote": "614"
    },
    {
      "id": "71dd",
      "chave": "dialog__humba_chopper2",
      "hash_es": "b83f2f3817b541ca",
      "texto_ptbr": "Helicóptero com bandeja de carga. O que mais alguém pedir na vida?",
      "lote": "507"
    },
    {
      "id": "71de",
      "chave": "dialog__humba_chopper3",
      "hash_es": "466baec4017ed4a8",
      "texto_ptbr": "Helicóptero de ataque rápido... infelizmente sem capacidade de atacar nada.",
      "lote": "507"
    },
    {
      "id": "d67a",
      "chave": "dialog__humba_detacher",
      "hash_es": "63c3cf74b8dfa4c7",
      "texto_ptbr": "Veículos ficar espertos agora. Lembrar de abrir asas antes de urso bater no chão!",
      "lote": "507"
    },
    {
      "id": "58bb",
      "chave": "dialog__humba_doesitall",
      "hash_es": "aa897b35b0405210",
      "texto_ptbr": "Terra, mar, ar... até debaixo das ondas não ser problema para o faz-tudo da Humba.",
      "lote": "507"
    },
    {
      "id": "2512",
      "chave": "dialog__humba_foldingwing",
      "hash_es": "e99b757a19a53cac",
      "texto_ptbr": "Ser carro? Ser avião? Bem, na verdade, este ser os dois.",
      "lote": "507"
    },
    {
      "id": "965c",
      "chave": "dialog__humba_galleon",
      "hash_es": "07c951c0f635c1d7",
      "texto_ptbr": "Navegar em galeão pirata tradicional... com motor de popa por garantia.",
      "lote": "507"
    },
    {
      "id": "3077",
      "chave": "dialog__humba_heavy",
      "hash_es": "6e363d47d06b9802",
      "texto_ptbr": "Este veículo que Humba gostar de chamar de bruto sem frescura.",
      "lote": "507"
    },
    {
      "id": "035e",
      "chave": "dialog__humba_hover",
      "hash_es": "1d3e4a3ed85d7b9b",
      "texto_ptbr": "Terra ou mar? Enfrentar os dois na geringonça flutuante da Humba.",
      "lote": "507"
    },
    {
      "id": "6d03",
      "chave": "dialog__humba_huge",
      "hash_es": "13ba5b89243f20fc",
      "texto_ptbr": "Quem dizer isso? Quem dizer que equipe Rare ser patriótica demais?",
      "lote": "507"
    },
    {
      "id": "dbb2",
      "chave": "dialog__humba_light",
      "hash_es": "831d07d7db086bb6",
      "texto_ptbr": "Leve e ágil, mas não aguentar muita pancada.",
      "lote": "507"
    },
    {
      "id": "81e2",
      "chave": "dialog__humba_monster",
      "hash_es": "beb8ce326723e30b",
      "texto_ptbr": "Este caminhão, e também monstro. Humba chamar de... Monstrecaminhão! Não, Caminhão Monstro!",
      "lote": "507"
    },
    {
      "id": "0b7b",
      "chave": "dialog__humba_plane1",
      "hash_es": "181e29edc307dcc9",
      "texto_ptbr": "Aeronave leve, boa para pilotos aprendizes.",
      "lote": "507"
    },
    {
      "id": "0b7c",
      "chave": "dialog__humba_plane2",
      "hash_es": "3c5174a8b6634bf4",
      "texto_ptbr": "Hélices usadas para empurrar em vez de puxar.",
      "lote": "507"
    },
    {
      "id": "0b7d",
      "chave": "dialog__humba_plane3",
      "hash_es": "60729ba8434071bc",
      "texto_ptbr": "Leve, ágil e correr como louco!",
      "lote": "507"
    },
    {
      "id": "0b7e",
      "chave": "dialog__humba_plane4",
      "hash_es": "50169dac346d8308",
      "texto_ptbr": "Não precisar de hélices com jato enorme amarrado ao avião!",
      "lote": "507"
    },
    {
      "id": "ad91",
      "chave": "dialog__humba_pusher",
      "hash_es": "fa7ec9febbf4b4ac",
      "texto_ptbr": "Ideal para empurrar objetos menores para fora do caminho.",
      "lote": "507"
    },
    {
      "id": "4358",
      "chave": "dialog__humba_racer1",
      "hash_es": "ad671fadcd6b5c92",
      "texto_ptbr": "Provavelmente não quebrar recorde de velocidade, mas bom o bastante para começar.",
      "lote": "507"
    },
    {
      "id": "4359",
      "chave": "dialog__humba_racer2",
      "hash_es": "18e0bd41ff2fac10",
      "texto_ptbr": "Mais cavalos significar mais velocidade por notas suadas.",
      "lote": "507"
    },
    {
      "id": "435a",
      "chave": "dialog__humba_racer3",
      "hash_es": "5c66f27c89a2d506",
      "texto_ptbr": "Este carro sim, usina de altas rotações!",
      "lote": "507"
    },
    {
      "id": "435b",
      "chave": "dialog__humba_racer4",
      "hash_es": "022c3cc8f04bdf72",
      "texto_ptbr": "Carro a jato maluco. Urso pisar no acelerador e segurar firme!",
      "lote": "507"
    },
    {
      "id": "dfbe",
      "chave": "dialog__humba_rammer",
      "hash_es": "85308d741d1a6e90",
      "texto_ptbr": "Grande, pesado e rápido, com punho para dar soco poderoso.",
      "lote": "507"
    },
    {
      "id": "b282",
      "chave": "dialog__humba_rocket",
      "hash_es": "9b39495f50028099",
      "texto_ptbr": "Foguete poderoso permitir urso mirar as estrelas... ou bater no teto.",
      "lote": "507"
    },
    {
      "id": "3def",
      "chave": "dialog__humba_spikey",
      "hash_es": "96f4512bb797372e",
      "texto_ptbr": "Mais espinhos que almofada de alfinetes, mas mais confortável de dirigir.",
      "lote": "507"
    },
    {
      "id": "25ed",
      "chave": "dialog__humba_spring",
      "hash_es": "2e077ecd144c0ddc",
      "texto_ptbr": "Pogotástico! Não precisar de rodas ou asas quando urso ter poder de mola!",
      "lote": "507"
    },
    {
      "id": "7f16",
      "chave": "dialog__humba_spy",
      "hash_es": "df3bffde8a79b839",
      "texto_ptbr": "Precisar espionar alguém ou algo? Este veículo vir preparado!",
      "lote": "507"
    },
    {
      "id": "8219",
      "chave": "dialog__humba_squirter",
      "hash_es": "dd3cd5ca2980db10",
      "texto_ptbr": "Pequeno transportador de líquido, encher e borrifar.",
      "lote": "507"
    },
    {
      "id": "cbb8",
      "chave": "dialog__humba_stunt",
      "hash_es": "f7358511a571a8e8",
      "texto_ptbr": "Molas e giroscópio igual a diversão séria de acrobacias!",
      "lote": "507"
    },
    {
      "id": "ad27",
      "chave": "dialog__humba_tall",
      "hash_es": "8771d8154aae87b7",
      "texto_ptbr": "Quase tão alto quanto veículo conseguir. Meio legal, mas sem ideia para que servir.",
      "lote": "507"
    },
    {
      "id": "5a99",
      "chave": "dialog__humba_tank1",
      "hash_es": "8f0dc9d5348de740",
      "texto_ptbr": "Pequeno e ágil com arma, mas só uma pequenina.",
      "lote": "507"
    },
    {
      "id": "5a9a",
      "chave": "dialog__humba_tank2",
      "hash_es": "09492e0c69b1b4cc",
      "texto_ptbr": "Tanque robusto com poder de fogo extra de granadas.",
      "lote": "507"
    },
    {
      "id": "5a9b",
      "chave": "dialog__humba_tank3",
      "hash_es": "aa4103021220b96a",
      "texto_ptbr": "Granadas e torre de ovos. O que mais urso precisar no calor da batalha?",
      "lote": "507"
    },
    {
      "id": "5a9c",
      "chave": "dialog__humba_tank4",
      "hash_es": "9261ab1543cd9d82",
      "texto_ptbr": "Blindado até o limite, mais míssil teleguiado Torpedilo. Nada ficar no caminho!",
      "lote": "513"
    },
    {
      "id": "84e1",
      "chave": "dialog__humba_taxi1",
      "hash_es": "7bbcbb318c904614",
      "texto_ptbr": "Táxi bem taxístico, conseguir levar um passageiro magro.",
      "lote": "507"
    },
    {
      "id": "84e2",
      "chave": "dialog__humba_taxi2",
      "hash_es": "a1d9631135eaab03",
      "texto_ptbr": "Táxi com sofá, ideal para passageiro maior.",
      "lote": "507"
    },
    {
      "id": "84e3",
      "chave": "dialog__humba_taxi3",
      "hash_es": "4d1b58e5428fcb13",
      "texto_ptbr": "Táxi com reboque, para ainda mais bondade no transporte de passageiros.",
      "lote": "507"
    },
    {
      "id": "84e4",
      "chave": "dialog__humba_taxi4",
      "hash_es": "234e212aee7efb0b",
      "texto_ptbr": "Este táxi como ônibus. Urso sonhar em ser motorista de ônibus quando filhote?",
      "lote": "507"
    },
    {
      "id": "c8ad",
      "chave": "dialog__humba_trailer",
      "hash_es": "5540cb1ca9863b09",
      "texto_ptbr": "Trator e reboque. Todo mundo querer dirigir um alguma vez!",
      "lote": "507"
    },
    {
      "id": "0a94",
      "chave": "dialog__humba_truck1",
      "hash_es": "5e720826e245c23c",
      "texto_ptbr": "Pequena melhoria na capacidade de carga do Carrinho.",
      "lote": "507"
    },
    {
      "id": "0a95",
      "chave": "dialog__humba_truck2",
      "hash_es": "b27bed1b6a273a0a",
      "texto_ptbr": "Equipado com bandeja enorme para mover objetos grandes, se não sacudir demais.",
      "lote": "507"
    },
    {
      "id": "0a96",
      "chave": "dialog__humba_truck3",
      "hash_es": "295ea328e4cc0232",
      "texto_ptbr": "Compartimento de carga mais fundo tornar este o jeito mais seguro de transportar itens delicados.",
      "lote": "507"
    },
    {
      "id": "8644",
      "chave": "dialog__humba_ufo",
      "hash_es": "54dedddf139a5055",
      "texto_ptbr": "Reviver o Disco do Perigo no próprio OVNI do urso!",
      "lote": "507"
    },
    {
      "id": "aac6",
      "chave": "dialog__humba_wedge",
      "hash_es": "060c222003ab92b7",
      "texto_ptbr": "Cunha simples e direta, muita risada ao dirigir.",
      "lote": "507"
    },
    {
      "id": "7343",
      "chave": "dialog__humba_wide",
      "hash_es": "8d8b33159404eb26",
      "texto_ptbr": "Largo, mas poder quebrar mais fácil que os ovos do Terry na betoneira.",
      "lote": "507"
    },
    {
      "id": "9c48",
      "chave": "dialog__mumbo_airchassis1",
      "hash_es": "5126bad14135dc8d",
      "texto_ptbr": "Chassi ideal para aeronaves leves.",
      "lote": "507"
    },
    {
      "id": "9c49",
      "chave": "dialog__mumbo_airchassis2",
      "hash_es": "d9995e73e3cd250d",
      "texto_ptbr": "Chassi de biplano. Bom para veículos aéreos mais complexos.",
      "lote": "507"
    },
    {
      "id": "c6d0",
      "chave": "dialog__mumbo_hoverchassis1",
      "hash_es": "87e59c90cccb906a",
      "texto_ptbr": "Chassi ideal para construir o primeiro helicóptero.",
      "lote": "507"
    },
    {
      "id": "c6d1",
      "chave": "dialog__mumbo_hoverchassis2",
      "hash_es": "77ae10e6130fc80c",
      "texto_ptbr": "Chassi de helicóptero avançado, funcionar bem com veículos de hélice dupla.",
      "lote": "614"
    },
    {
      "id": "aa6b",
      "chave": "dialog__mumbo_landchassis1",
      "hash_es": "b069d67ca03ec8cc",
      "texto_ptbr": "Chassi básico para ajudar urso a se locomover.",
      "lote": "614"
    },
    {
      "id": "aa6c",
      "chave": "dialog__mumbo_landchassis2",
      "hash_es": "c8b78601d9e83ac5",
      "texto_ptbr": "Chassi um pouco mais avançado, bom para construtores dedicados.",
      "lote": "507"
    },
    {
      "id": "aa6d",
      "chave": "dialog__mumbo_landchassis3",
      "hash_es": "3a883b373559d1d5",
      "texto_ptbr": "Ótimo chassi para veículos mais avançados.",
      "lote": "507"
    },
    {
      "id": "aa6e",
      "chave": "dialog__mumbo_landchassis4",
      "hash_es": "56c18554dac62c15",
      "texto_ptbr": "O chassi definitivo para veículos terrestres!",
      "lote": "507"
    },
    {
      "id": "9545",
      "chave": "dialog__mumbo_seachassis1",
      "hash_es": "b35e11b16d79c352",
      "texto_ptbr": "Chassi flutuante muito simples.",
      "lote": "507"
    },
    {
      "id": "9546",
      "chave": "dialog__mumbo_seachassis2",
      "hash_es": "d545d853c1d17172",
      "texto_ptbr": "Chassi de casco duplo para embarcações mais avançadas.",
      "lote": "507"
    },
