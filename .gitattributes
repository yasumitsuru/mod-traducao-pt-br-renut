# Texto normalizado em LF; binários marcados para nunca sofrer conversão.
* text=auto eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.nbpatch binary
*.zip binary
*.png binary
*.ico binary
